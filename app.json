{
  "expo": {
    "name": "Screen Time Scorer",
    "slug": "screentimescorer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "screentimescorer",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sampritchard.screentimescorer",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.com.sampritchard.screentimescorer"
        ]
      },
      "infoPlist": {
        "NSFamilyControlsUsageDescription": "Screen Time Scorer uses Screen Time data to calculate your Phone Health Score and suggest healthier habits on this device.",
        "NSFaceIDUsageDescription": "Screen Time Scorer uses Face ID to unlock the app after you sign in."
      }
    },
    "android": {
      "package": "com.sampritchard.screentimescorer",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F17",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.PACKAGE_USAGE_STATS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-dev-client",
      "./plugins/withFamilyControls.js",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Screen Time Scorer uses Face ID to unlock the app after you sign in."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "replace-after-eas-init"
      }
    }
  }
}
